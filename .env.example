# Global Environment Variables for POS Microservices

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# M-Pesa Integration (Payment Service)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback

# Africa's Talking (Notification Service)
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=your_africas_talking_username

# SMTP Email Settings (Notification Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Redis Cache
REDIS_URL=redis://redis:6379

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://pos_user:pos_password@rabbitmq:5672

# Database (Default - each service can override)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Business Configuration
BUSINESS_NAME=My Business
BUSINESS_TYPE=retail
CURRENCY=USD
TAX_RATE=0.08
RECEIPT_FOOTER=Thank you for your business!
