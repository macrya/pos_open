{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "A fully functional POS system that can be customized for any business",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch backend --exec ts-node backend/server.ts",
    "dev:client": "cd frontend && npm run dev",
    "build": "npm run build:server && npm run build:client && npm run copy:frontend",
    "build:server": "tsc -p backend/tsconfig.json",
    "build:client": "cd frontend && npm run build",
    "copy:frontend": "mkdir -p dist/public && cp -r frontend/dist/* dist/public/",
    "start": "NODE_ENV=production node dist/server.js",
    "install:all": "npm install && cd frontend && npm install",
    "seed": "ts-node backend/scripts/seedData.ts"
  },
  "keywords": ["pos", "point-of-sale", "retail", "restaurant", "sales"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^9.2.2",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
